[resource]
code = "shader_type spatial;
render_mode depth_prepass_alpha;

uniform vec3 testPoint;
uniform float testPointRadius;

uniform sampler2D screen_texture : source_color, hint_screen_texture, repeat_disable;
uniform sampler2D depth_texture : source_color, hint_depth_texture, repeat_disable;

void vertex() {
  POSITION = vec4(VERTEX.xy, 1.0, 1.0);
}

float GetDepth(vec2 pos, mat4 projectionMatrix){
	float depth = textureLod(depth_texture, pos, 0.0).r;
	vec4 view = projectionMatrix * vec4(pos*2.0-1.0,depth,1.0);
	view.xyz /= view.w;
	return length(view);
}

vec3 ClosestPoint(vec3 origin, vec3 direction, vec3 other){
	vec3 newDir = normalize(direction);
	vec3 v = other - origin;
	float d = dot(v, newDir);
	return origin + newDir * d;
}

void fragment() {
	float depth = GetDepth(SCREEN_UV, INV_PROJECTION_MATRIX);
	vec3 ro_world = INV_VIEW_MATRIX[3].xyz;
	vec4 clipPos = vec4((FRAGCOORD.xy / VIEWPORT_SIZE.xy) * 2.0 - 1.0, FRAGCOORD.z, 1.0);
	vec4 viewPos = INV_PROJECTION_MATRIX * clipPos;
	vec3 rd_world = normalize(viewPos.xyz / viewPos.w);
	rd_world = mat3(INV_VIEW_MATRIX) * rd_world;

	//vec3 worldcenter = normalize(vec3(0.0, 0.0, 0.0) - ro_world);

	vec3 closestPoint = ClosestPoint(ro_world, rd_world, testPoint);

	//ALBEDO = vec3(distanceFromPointToLine(ro_world, ro_world + rd_world * 1000.0, vec3(0.0)));
	if (distance(closestPoint, testPoint) < testPointRadius){
		NORMAL = (VIEW_MATRIX * vec4(closestPoint - testPoint, 0.0)).xyz;
		vec3 worldPoint = (testPoint + normalize(closestPoint - testPoint) * testPointRadius);

		if (length(worldPoint - ro_world) < depth){
			vec4 ndc = PROJECTION_MATRIX * VIEW_MATRIX * vec4(worldPoint, 1.0);
			float newdepth = (ndc.z / ndc.w) * 0.5 + 0.5;
			DEPTH = newdepth;
		}
		else{
			discard;
		}
	}
	else{
		discard;
	}

	//
	//vec3 ro_world = INV_VIEW_MATRIX[3].xyz;
	//vec4 clipPos = vec4((FRAGCOORD.xy / VIEWPORT_SIZE.xy) * 2.0 - 1.0, FRAGCOORD.z, 1.0);
	//vec4 viewPos = INV_PROJECTION_MATRIX * clipPos;
	//vec3 rd_world = normalize(viewPos.xyz / viewPos.w);
	//rd_world = mat3(INV_VIEW_MATRIX) * rd_world;
//
	//vec3 view_dir = normalize(rd_world);
//
	//vec4 dust = texture(DustTexture, ((ro_world + (rd_world * min(depth * 0.8, Sand2DBlend))) * TextureScale) + PanningDirection * TIME * Speed);
	//float sampled = texture(heightEffect, vec2((dot(view_dir, vec3(0.0, 1.0, 0.0)) + 1.0) / 2.0, 0.5)).r;
	////vec3 color = blur(SCREEN_UV, VIEWPORT_SIZE).rgb;
	////ALBEDO = vec3(sampled);
	//ALBEDO = dust.rgb;
	//ALPHA = sampled * clamp(smoothstep(SandBegin, SandEnd, depth) * Density, 0.0, 1.0);
}"
