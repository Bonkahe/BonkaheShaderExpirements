[resource]
code = "shader_type spatial;
render_mode unshaded, fog_disabled;

uniform sampler2D screen_texture : source_color, hint_screen_texture, repeat_disable;
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable;

uniform vec4 EdgeColor : source_color = vec4(1.0);
uniform float FadeOutDistance = 100.0;
uniform float DepthBreakDistance : hint_range(0.0, 10.0) = 0.359;
uniform float DarkestCutoff : hint_range(0.0, 1.0) = 0.299;
uniform float Sensitivity : hint_range(0.0, 5.0) = 0.21;
uniform float Softness : hint_range(0.0, 1.0) = 0.353;
uniform float BlendRange : hint_range(0.0, 10.0) = 2.156;
uniform float StepCount : hint_range(3.0, 8.0, 2.0) = 3.0;

void vertex() {
  POSITION = vec4(VERTEX.xy, 1.0, 1.0);
}

float GetDepth(vec2 pos, mat4 projectionMatrix){
	float depth = textureLod(depth_texture, pos, 0.0).r;
	vec4 view = projectionMatrix * vec4(pos*2.0-1.0,depth,1.0);
	view.xyz /= view.w;
	return length(view);
	//return depth;
}

float GetBrightness(vec3 color){
	return (color.r + color.g + color.b) / 3.0;
}

//float BlendFloats(float base, float blend){
	//return (blend < 0.5) ? (2.0 * base * blend + base * base * (1.0 - 2.0 * blend)) : (sqrt(base) * (2.0 * blend - 1.0) + 2.0 * base * (1.0 - blend));
//}
//
//
//
//vec3 BlendVec3(vec3 base, vec3 blend){
	//return vec3(BlendFloats(base.r, blend.r), BlendFloats(base.g, blend.g), BlendFloats(base.b, blend.b));
//}

float blendOverlayfloat(float base, float blend) {
	return base<0.5?(2.0*base*blend):(1.0-2.0*(1.0-base)*(1.0-blend));
}

vec3 blendOverlay(vec3 base, vec3 blend) {
	return vec3(blendOverlayfloat(base.r,blend.r),blendOverlayfloat(base.g,blend.g),blendOverlayfloat(base.b,blend.b));
}

//vec3 blendOverlay(vec3 base, vec3 blend, float opacity) {
	//return (blendOverlay(base, blend) * opacity + base * (1.0 - opacity));
//}

vec3 blendHardLightbase(vec3 base, vec3 blend) {
	return blendOverlay(blend,base);
}

vec3 blendHardLight(vec3 base, vec3 blend, float opacity) {
	return (blendHardLightbase(base, blend) * opacity + base * (1.0 - opacity));
}

void fragment() {
	float depth = GetDepth(SCREEN_UV, INV_PROJECTION_MATRIX);

	float curDistance = 1.0 - smoothstep(1.0, FadeOutDistance, depth);
	float stepRange = BlendRange * curDistance;
	vec2 tempUV = SCREEN_UV;
	vec3 currentColor = vec3(0.0);

	vec2 BrightestColorPos = tempUV;
	vec2 DarkestColorPos = tempUV;
	vec3 brightestColor = vec3(0.0);
	vec3 darkestColor = vec3(1.0);
	float brightestValue = 0.0;
	float darkestValue = 1.0;
	float currentValue = brightestValue;

	float tempDepth = depth;

	float halfRange = floor(StepCount / 2.0);

	for (float x = 0.0; x < StepCount; x++){
		for (float y = 0.0; y < StepCount; y++){

			tempUV = SCREEN_UV + ((vec2(x - halfRange ,y - halfRange) / VIEWPORT_SIZE) * stepRange);

			tempDepth = GetDepth(tempUV, INV_PROJECTION_MATRIX);
			if (abs(tempDepth - depth) > DepthBreakDistance){
				discard;
			}

			currentColor = texture(screen_texture, tempUV).rgb;
			currentValue = GetBrightness(currentColor);

			if (currentValue > brightestValue){
				brightestValue = currentValue;
				brightestColor = currentColor;
				BrightestColorPos = tempUV;
			}

			if (currentValue < darkestValue){
				darkestValue = currentValue;
				darkestColor = currentColor;
				DarkestColorPos = tempUV;
			}
		}
	}

	float edgeDetection = smoothstep(max(Sensitivity - Softness, 0.0), min(Sensitivity + Softness, 1.0), brightestValue - darkestValue);
	float darkestMask = 1.0 - smoothstep(0.0, DarkestCutoff, darkestValue);
	float edgeDistance = pow(smoothstep(0.0, 0.1, length(DarkestColorPos - BrightestColorPos)), Sensitivity);
	//ALBEDO = vec3(edgeDetection * darkestMask * edgeDistance);
	ALPHA = edgeDetection * darkestMask * edgeDistance * EdgeColor.a;
	ALBEDO = blendHardLightbase(texture(screen_texture, SCREEN_UV).rgb, EdgeColor.rgb);

	//
	//vec3 ro_world = INV_VIEW_MATRIX[3].xyz;
	//vec4 clipPos = vec4((FRAGCOORD.xy / VIEWPORT_SIZE.xy) * 2.0 - 1.0, FRAGCOORD.z, 1.0);
	//vec4 viewPos = INV_PROJECTION_MATRIX * clipPos;
	//vec3 rd_world = normalize(viewPos.xyz / viewPos.w);
	//rd_world = mat3(INV_VIEW_MATRIX) * rd_world;
//
	//vec3 view_dir = normalize(rd_world);
//
	//vec4 dust = texture(DustTexture, ((ro_world + (rd_world * min(depth * 0.8, Sand2DBlend))) * TextureScale) + PanningDirection * TIME * Speed);
	//float sampled = texture(heightEffect, vec2((dot(view_dir, vec3(0.0, 1.0, 0.0)) + 1.0) / 2.0, 0.5)).r;
	////vec3 color = blur(SCREEN_UV, VIEWPORT_SIZE).rgb;
	////ALBEDO = vec3(sampled);
	//ALBEDO = dust.rgb;
	//ALPHA = sampled * clamp(smoothstep(SandBegin, SandEnd, depth) * Density, 0.0, 1.0);
}"
